# ---------------------------------------------------------------------------------------------------------
# DB Incident Replay v1.0: configuration. Copy to .env. Never commit .env.
# ---------------------------------------------------------------------------------------------------------

# Safe default: demo mode never connects to PostgreSQL. All data is synthetic, labelled, and kept in a separate file.
DEMO_MODE=false
# The flight recorder starts with the app. Set false to disable background collection (manual refresh only).
AUTO_MONITOR=true

# ----- One PostgreSQL instance (used when DEMO_MODE=false) -----
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dir_incident_lab
DB_USER=dir_monitor
DB_PASSWORD=postgres
# disable | allow | prefer | require | verify-ca | verify-full. Use verify-full (with DB_SSLROOTCERT) for anything remote.
DB_SSLMODE=prefer
# DB_SSLROOTCERT=/etc/ssl/certs/your-ca.pem
# DB_INSTANCE_ID=default
# DB_INSTANCE_NAME=Primary instance
# DB_ENVIRONMENT=production

# ----- Several instances: a JSON list; passwords come from environment variables, never from the file -----
# INSTANCES_FILE=./instances.json
#   [{"id":"orders-primary","name":"Orders primary","host":"10.0.0.5","port":5432,"dbname":"orders","user":"incident_reader",
#     "password_env":"ORDERS_PRIMARY_PASSWORD","sslmode":"verify-full","sslrootcert":"/etc/ssl/ca.pem","log_file":"/var/log/postgresql/orders.log"}]

# ----- Collection intervals (seconds); also editable in the UI -----
MONITOR_INTERVAL_SECONDS=15
# DIR_STANDARD_INTERVAL_S=60
# DIR_SLOW_INTERVAL_S=300
# Detection thresholds (all are editable in the UI; see docs/flight-recorder.md)
LONG_QUERY_SECONDS=30
IDLE_TXN_SECONDS=60
# DIR_BLOCK_WARN_S=15
# DIR_BLOCK_CRIT_S=60
# DIR_CONN_WARN_PCT=80

# ----- Retention (days) -----
# DIR_RETENTION_METRICS_DAYS=14
# DIR_RETENTION_EVIDENCE_DAYS=90

# ----- Query text handling: redact (literals masked, default) | full (credentials still masked) | none (hidden) -----
QUERY_TEXT_MODE=redact
# Extra regular expressions to mask, separated by ||
# REDACT_PATTERNS=ACME-\d{6}||internal-[a-z]+

# ----- Optional server log (stderr text format; csvlog/jsonlog are not parsed). The app's OS user needs read access. -----
# PG_LOG_FILE=/var/log/postgresql/postgresql-16-main.log
# PG_LOG_UTC_OFFSET_MINUTES=0
PG_LOG_TAIL_BYTES=2097152

# ----- Access control: none (local use only!) | token -----
AUTH_MODE=none
# Roles: viewer (read), operator (investigate, export), admin (settings, audit). Tokens >= 16 characters.
# AUTH_MODE=token
# API_TOKENS=viewer:change-me-viewer-token-1,operator:change-me-operator-token-1,admin:change-me-admin-token-001

# ----- Limits -----
# DB_CONNECT_TIMEOUT=5
# DB_STATEMENT_TIMEOUT_MS=5000
# MAX_CONCURRENT_COLLECTIONS=2
QUERY_TEXT_MODE=redact
# ----- Optional Patroni REST integration (read-only) -----
# PATRONI_URL=https://patroni.example:8008
# PATRONI_VERIFY_TLS=true

 DATA_DIR=./data
# LOG_LEVEL=INFO
